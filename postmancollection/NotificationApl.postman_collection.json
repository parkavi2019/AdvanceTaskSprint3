		{
			"name": "Login",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"\r",
							"const loginUrl = 'http://localhost:60968/authentication/authentication/signin';\r",
							"\r",
							"\r",
							"const loginPayload = {\r",
							"    \"username\": \"manjujayanthi03@gmail.com\",\r",
							"    \"password\": \"manju@rajesh\"\r",
							"};\r",
							"\r",
							"// Make a request to get the access token\r",
							"pm.sendRequest({\r",
							"    url: loginUrl,\r",
							"    method: 'POST',\r",
							"    header: {\r",
							"        'Content-Type': 'application/json'\r",
							"    },\r",
							"    body: JSON.stringify(loginPayload)\r",
							"}, function (err, res) {\r",
							"    if (err) {\r",
							"        console.log(\"Login failed\", err);\r",
							"    } else {\r",
							"       \r",
							"        let responseData = res.json();\r",
							"        let accessToken = responseData.token; \r",
							"\r",
							"        \r",
							"        pm.environment.set(\"accessToken\", accessToken);\r",
							"\r",
							"        console.log(\"Token saved:\", accessToken);\r",
							"    }\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Login\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.isSuccess).to.eql(100);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
