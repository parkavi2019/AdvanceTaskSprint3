		{
			"name": "AddSkill Request",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.sendRequest({\r",
							"    url: \"https://example.com/api/auth\",\r",
							"    method: \"POST\",\r",
							"    header: { \"Content-Type\": \"application/json\" },\r",
							"    body: {\r",
							"        mode: \"raw\",\r",
							"        raw: JSON.stringify({ username: \"user\", password: \"pass\" })\r",
							"    }\r",
							"}, function (err, res) {\r",
							"    if (err) {\r",
							"        console.log(\"Request Error:\", err);\r",
							"    } else if (!res || !res.json) {\r",
							"        console.log(\"Invalid Response:\", res);\r",
							"    } else {\r",
							"        try {\r",
							"            let jsonResponse = res.json();\r",
							"            if (jsonResponse.token) {\r",
							"                pm.globals.set(\"auth_token\", jsonResponse.token);\r",
							"                console.log(\"Token Saved:\", jsonResponse.token);\r",
							"            } else {\r",
							"                console.log(\"Token Not Found in Response:\", jsonResponse);\r",
							"            }\r",
							"        } catch (error) {\r",
							"            console.log(\"JSON Parsing Error:\", error);\r",
							"        }\r",
							"    }\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
